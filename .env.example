# Variables de entorno de referencia (docker-compose.yml ya las define).
# Copiar a .env solo si se quieren sobrescribir.
AWS_ENDPOINT_URL=http://emulador:4566
AWS_ENDPOINT_URL_S3=http://s3.localhost.localstack.cloud:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
REDIS_HOST=redis
REDIS_PORT=6379
# TTL de cada libro en Redis (segundos)
REDIS_TTL=300
# Reglas de préstamo
MAX_PRESTAMOS=3
DIAS_PRESTAMO=14
MAX_RENOVACIONES=2
MULTA_POR_DIA=1000
# TABLE_NAME lo asigna CDK al desplegar (output TableName)
